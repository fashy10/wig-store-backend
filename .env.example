# Database (MongoDB Atlas gives you this connection string when you create a free cluster)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/wigstore

# Admin login (this is the ONLY account that can log in and manage wigs)
ADMIN_EMAIL=girlfriend@example.com
ADMIN_PASSWORD=choose-a-strong-password

# JWT secret - any long random string, used to sign login tokens
JWT_SECRET=replace-this-with-a-long-random-string

# Supabase (free account at supabase.com - used to store wig photos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Server port
PORT=3001
